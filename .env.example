# ─── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/astano?schema=public"

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-too-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

PUBLIC_BASE_URL=http://localhost:5000
# local = write to ./storage (dev). r2 = Cloudflare R2 (needs the values below).
STORAGE_DRIVER=local

# ─── Cloudflare R2 ─────────────────────────────────────────────────
# Two buckets: public product media, and PRIVATE customer design files.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_MEDIA=astano-media
R2_BUCKET_FILES=astano-design-files
R2_PUBLIC_URL=

# ─── Mail (Phase 3) ──────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Astano <info@astano.de>"

# ─── Frontend ────────────────────────────────────────────────────────────────
# Comma-separated. Exact scheme + host, no trailing slash.
CORS_ORIGINS=http://localhost:3000

# ─── Cookies ─────────────────────────────────────────────────────────────────
# Applies to the guest cart, quote basket, wishlist and refresh token.
#
# lax   — site and API share a registrable domain (astano.de + api.astano.de),
#         and for local development. The safer default.
# none  — they do not (a Vercel frontend calling a Render API). The browser
#         then treats every API call as cross-site and DROPS a lax cookie
#         without a word, so guests lose their basket between page loads.
#         Requires COOKIE_SECURE=true; the app refuses to start otherwise.
COOKIE_SAMESITE=lax
# Unset means "true in production". Set explicitly when overriding.
# COOKIE_SECURE=true
# Only to share cookies across subdomains, e.g. .astano.de
# COOKIE_DOMAIN=
