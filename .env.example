# ─── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/astano?schema=public"

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-too-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Encrypts the payment credentials the client enters in the dashboard. The one
# secret that stays here, because it is what protects every secret that does
# not — a stolen database without it yields no usable API keys.
#
#   openssl rand -hex 32
#
# Once a gateway is live this value is permanent: change it and every stored
# Stripe/PayPal key becomes unreadable. The app refuses to store a credential
# in production while this is still the placeholder.
CREDENTIALS_KEY=dev-credentials-key-change-me-please

PUBLIC_BASE_URL=http://localhost:5000

# Where the SHOP is — the origin a customer opens, not this API.
#
# Every link in every email is built from this: password resets, the welcome
# mail, quote links, and the dashboard link staff get when a print file
# arrives. They used to be built from PUBLIC_BASE_URL, which is this API, so a
# password reset pointed at a URL that answers 404 in JSON.
#
# Leave it empty and the first entry in CORS_ORIGINS is used, which is right
# on every deployment so far. Set it when several origins are allowed and the
# first is not the customer-facing one.
SHOP_BASE_URL=
# local = write to ./storage (dev). r2 = Cloudflare R2 (needs the values below).
STORAGE_DRIVER=local

# ─── Object storage (any S3-compatible provider) ─────────────────────────────
# Two buckets: public product media, and PRIVATE customer design files.
# The R2_ prefix is historical — the driver speaks plain S3.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_MEDIA=astano-media
R2_BUCKET_FILES=astano-design-files
# Public base URL for the media bucket.
R2_PUBLIC_URL=

# --- Cloudflare R2 (needs a card, even on the free tier) ---
# Set the account id and leave S3_ENDPOINT unset.
R2_ACCOUNT_ID=

# --- Supabase Storage (free, no card) ---
# S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
# S3_REGION=eu-central-1          # whatever region the project is in
# S3_FORCE_PATH_STYLE=true        # Supabase requires path-style
# Credentials come from Project Settings → Storage → S3 access keys.
# R2_PUBLIC_URL=https://<project-ref>.supabase.co/storage/v1/object/public/astano-media

# ─── Mail (Phase 3) ──────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Astano <info@astano.de>"

# ─── Frontend ────────────────────────────────────────────────────────────────
# Comma-separated. Exact scheme + host, no trailing slash.
# Lets a scheduler run the maintenance jobs over HTTP.
#
# Only needed where node-cron cannot run — i.e. a serverless deployment. Vercel
# Cron sends it as 'Authorization: Bearer <CRON_SECRET>'; unset, /cron/run
# refuses every call rather than sitting open.
#   openssl rand -hex 32
CRON_SECRET=

CORS_ORIGINS=http://localhost:3000

# ─── Cookies ─────────────────────────────────────────────────────────────────
# Applies to the guest cart, quote basket, wishlist and refresh token.
#
# lax   — site and API share a registrable domain (astano.de + api.astano.de),
#         and for local development. The safer default.
# none  — they do not (a Vercel frontend calling a Render API). The browser
#         then treats every API call as cross-site and DROPS a lax cookie
#         without a word, so guests lose their basket between page loads.
#         Requires COOKIE_SECURE=true; the app refuses to start otherwise.
COOKIE_SAMESITE=lax
# Unset means "true in production". Set explicitly when overriding.
# COOKIE_SECURE=true
# Only to share cookies across subdomains, e.g. .astano.de
# COOKIE_DOMAIN=
