// ─────────────────────────────────────────────────────────────────────────────
// Role-based pricing and quantity tier ladders.
//
// This is the highest-risk area of the whole rebuild (spec risk #1). Six
// surfaces must agree — archive range, product page, tier table, cart, bundle
// preview, quote line — so every one of them goes through the single pure
// function in src/domain/pricing/resolvePrice.ts. Nothing computes a price
// inline.
//
// Money is Decimal, never Float. 8 tier rungs multiplied by role overrides and
// 19% VAT will drift by cents in binary floating point, and B2B customers
// reconcile invoices.
// ─────────────────────────────────────────────────────────────────────────────

/// The roles a price can be calculated for. Deliberately narrower than
/// UserRole: staff and pricing are different concerns, and
/// domain/pricing/effectiveRole.ts maps (role, status) onto this (rule R5b).
enum PriceRole {
  GUEST
  B2C
  RESELLER
}

/// How a tier rung expresses its value.
enum TierType {
  /// The rung IS the unit price.
  FIXED_PRICE
  /// Percent off the role's base price.
  PERCENTAGE
  /// Absolute amount off the role's base price.
  FIXED_AMOUNT
}

/// Base and sale price for one product in one role.
/// A missing row means that role falls back to the next-cheapest defined role,
/// resolved in resolvePrice() — never in a query.
model ProductPrice {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  role PriceRole

  basePrice Decimal  @db.Decimal(12, 4)
  salePrice Decimal? @db.Decimal(12, 4)

  /// Optional scheduled sale window (WooCommerce sale price dates). Outside it
  /// the sale price is ignored — resolvePrice() decides, never a query.
  saleStartsAt DateTime?
  saleEndsAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, role])
  @@map("product_prices")
}

/// One rung of a quantity ladder — "buy 250+, pay X" (§4.2, "Mehr kaufen, mehr
/// sparen"). Both B2C and Reseller get ladders; the Reseller one sits roughly
/// 25–35% below B2C.
model ProductPriceTier {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  role        PriceRole
  minQuantity Int

  type  TierType @default(FIXED_PRICE)
  value Decimal  @db.Decimal(12, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, role, minQuantity])
  @@index([productId, role])
  @@map("product_price_tiers")
}

/// Variant-level override. Present only when a specific variant is priced
/// differently from its product; resolvePrice() prefers these and falls back to
/// the product rows. Kept as separate tables rather than nullable columns so
/// the database can actually enforce uniqueness — a nullable FK in a composite
/// unique index does not constrain anything in PostgreSQL.
model VariantPrice {
  id        String         @id @default(uuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  role PriceRole

  basePrice Decimal  @db.Decimal(12, 4)
  salePrice Decimal? @db.Decimal(12, 4)

  /// Optional scheduled sale window (WooCommerce sale price dates). Outside it
  /// the sale price is ignored — resolvePrice() decides, never a query.
  saleStartsAt DateTime?
  saleEndsAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([variantId, role])
  @@map("variant_prices")
}

model VariantPriceTier {
  id        String         @id @default(uuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  role        PriceRole
  minQuantity Int

  type  TierType @default(FIXED_PRICE)
  value Decimal  @db.Decimal(12, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([variantId, role, minQuantity])
  @@index([variantId, role])
  @@map("variant_price_tiers")
}

/// A quantity ladder attached to a category rather than a product.
///
/// One blanket rule instead of the same ladder typed onto forty products: every
/// product filed under the category inherits it. Carries no price of its own —
/// only rungs — so a percentage rung means "off whatever this customer would
/// otherwise pay for this product", and the product still needs its own price.
///
/// The quantity these rungs are measured against is **the whole category's
/// total in the cart**, not one line. Buying ten each of five different cutters
/// from one category reaches a threshold of 50 that no single line reaches.
/// That is what makes a category ladder worth having and not simply a
/// convenience for bulk-editing product ladders.
model CategoryPriceTier {
  id         String   @id @default(uuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  role        PriceRole
  minQuantity Int

  type  TierType @default(FIXED_PRICE)
  value Decimal  @db.Decimal(12, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([categoryId, role, minQuantity])
  @@index([categoryId, role])
  @@map("category_price_tiers")
}

/// A quantity ladder negotiated with one customer.
///
/// The most specific pricing rule there is, and the one that outranks the rest
/// by default: a ladder agreed with a named dealer should not be undercut — or
/// overridden — by a category-wide discount someone added later.
///
/// No role column. A customer has exactly one role, so the role is already
/// decided by whose ladder this is; storing it again would only create a way
/// for the two to disagree.
///
/// `productId` null means the ladder covers everything that customer buys.
/// Otherwise it is scoped to one product, which is how "we agreed a price with
/// them on this item" is expressed.
model CustomerPriceTier {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  minQuantity Int

  type  TierType @default(FIXED_PRICE)
  value Decimal  @db.Decimal(12, 4)

  /// Free-text note for staff — why this ladder exists, who agreed it.
  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId, minQuantity])
  @@index([userId, productId])
  @@map("customer_price_tiers")
}
