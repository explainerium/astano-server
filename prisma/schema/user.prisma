// ─────────────────────────────────────────────────────────────────────────────
// Users, roles and authentication.
// Source of truth: ASTANO_REBUILD_SPEC.md §2.6 (roles), §4.1 (B2B mode),
// §4.4 (registration flow), risk #12 (password migration).
// ─────────────────────────────────────────────────────────────────────────────

/// The five roles that exist. Deliberately flat — this shop has exactly one
/// B2B tier, so a capability matrix would be machinery without a purpose.
///
/// GUEST is never stored on a User row. It exists because resolvePrice() takes
/// a role for every request, including anonymous ones, and guests get their own
/// tier ladder (§4.2). The old site modelled it the same way (`wholesalex_guest`).
enum UserRole {
  GUEST
  B2C
  RESELLER
  SHOP_MANAGER
  ADMIN
}

/// Separate from role. Every B2B registration is manually approved
/// (`_settings_user_status_option = admin_approve`), so a RESELLER can exist
/// as PENDING. Auth guards must always check both.
///
/// Only ACTIVE may trade. effectiveRole() prices everything else as a guest, so
/// adding a state here can never accidentally hand out wholesale rates.
enum UserStatus {
  ACTIVE

  /// Registered, waiting on a staff decision. A RESELLER sits here until their
  /// application is approved.
  PENDING

  /// Application declined.
  REJECTED

  /// Partially blocked, by staff decision.
  ///
  /// The account still works as an account: they can sign in, read their
  /// history and correct their own details. What stops is trading — no cart,
  /// no checkout, no quote request — and a dealer here pays guest prices.
  /// Suspension is a commercial measure (a payment dispute, an abuse
  /// investigation), not a lockout, so it must not strand somebody outside
  /// their own invoices.
  SUSPENDED

  /// Prepared by staff, not yet live.
  ///
  /// For accounts an admin keys in before the customer exists to them — a
  /// dealer who phoned, a record migrated from the old shop. The row is real
  /// and editable but sign-in is refused until it is activated. The product
  /// catalogue's DRAFT means the same thing.
  DRAFT
}

model User {
  id String @id @default(uuid())

  email        String @unique
  passwordHash String

  role   UserRole   @default(B2C)
  status UserStatus @default(ACTIVE)

  // Profile.
  //
  // Both registration forms — B2C on My Account and the dealer form — collect
  // the same 16 fields (§4.4). astano's retail buyers are bakeries, so company
  // and a full address are required even for B2C. The fields below are the ones
  // shared by both; B2bApplication holds only the dealer-specific extras
  // (registerNumber, website, businessType, expectedVolume, message).
  firstName String?
  lastName  String?
  company   String?
  phone     String?
  vatNumber String?

  /// "Herr" / "Frau". Free text rather than an enum — the form offers two
  /// options today and a closed set would need a migration to add a third.
  salutation String?

  /// Date the customer's business was founded ("Gründungsdatum").
  foundingDate DateTime?

  /// Member of the PSI trade association. Asked on both registration forms.
  psiMember Boolean @default(false)

  /// When the AGB and privacy policy were accepted.
  ///
  /// A timestamp, not a boolean: what has to be provable is *when* consent was
  /// given. The newsletter module records confirmedAt for exactly this reason.
  /// Null means the account predates the requirement, which is different from
  /// "declined" — nobody can register without accepting.
  termsAcceptedAt DateTime?

  /// Preferred locale, e.g. "en" or "de". Drives email language.
  locale String @default("en")

  /// True once an EU VAT number has been validated against VIES.
  /// Reverse charge depends on this, so it is never inferred at request time.
  vatValidated   Boolean   @default(false)
  vatValidatedAt DateTime?

  lastLoginAt DateTime?

  /// Set when staff delete the account without destroying it.
  ///
  /// A row, not a status, because deletion is orthogonal to everything else:
  /// restoring has to put the account back exactly as it was, and folding it
  /// into UserStatus would lose whatever state it held. Orders reference users
  /// with SetNull, so a hard delete really does erase the customer from the
  /// sales record — that is precisely why the reversible option exists and why
  /// it is the one the UI offers first.
  ///
  /// Deleted accounts are excluded from every staff list and refused sign-in.
  /// The email stays on the row and stays unique, so the address cannot be
  /// re-registered while a recoverable account holds it.
  deletedAt DateTime?
  deletedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses           Address[]
  b2bApplication      B2bApplication?
  carts               Cart[]
  orders              Order[]
  orderNotes          OrderNote[]
  /// Artwork this account uploaded. See Asset.uploadedBy.
  assetsUploaded      Asset[]      @relation("AssetUploader")
  quoteBaskets        QuoteBasket[]
  quoteRequests       QuoteRequest[]
  wishlist            Wishlist?
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  emailChangeTokens   EmailChangeToken[]

  /// Products this staff account created. See Product.createdBy.
  productsCreated Product[] @relation("ProductAuthor")

  /// Quantity ladders negotiated with this customer.
  priceTiers CustomerPriceTier[]

  /// Page content this account last edited. Editing is ADMIN-only, so these are
  /// empty on every other role. See content.prisma.
  contentEntriesEdited ContentEntry[] @relation("ContentEntryEditor")
  contentMediaEdited   ContentMedia[] @relation("ContentMediaEditor")
  pagesEdited          Page[]         @relation("PageEditor")

  @@index([role, status])
  @@index([deletedAt])
  @@map("users")
}

/// A requested email address, held until the owner of that address proves they
/// can read it.
///
/// The new address lives here and **not** on the User until the link is used.
/// Storing it on the row with a "pending" flag would mean one careless query
/// away from emailing invoices to an address nobody has confirmed — or from
/// letting somebody claim an address they mistyped and lock themselves out.
///
/// Hashed like every other token: the link in the mailbox is the secret, the
/// database only holds its fingerprint.
model EmailChangeToken {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Already lowercased and trimmed by validation, so the uniqueness check at
  /// verification time compares like with like.
  newEmail String

  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("email_change_tokens")
}

/// Refresh tokens are stored hashed, never in plaintext — a leaked database
/// must not hand out working sessions. One row per active device.
model RefreshToken {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?

  userAgent String?
  ipAddress String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}
