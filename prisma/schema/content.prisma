// ─────────────────────────────────────────────────────────────────────────────
// Editable page content — what the shop may change without a developer.
//
// The storefront's marketing copy ships in frontend/messages/{de,en}.json and
// its pictures in frontend/src/lib/pageMedia.ts. Those files stay: they are the
// defaults. These tables are an *override* layer, merged over them per request,
// so an empty table means the site reads exactly as it does today and a
// database that cannot be reached is a slow page rather than a blank one.
//
// The same shape the email module already uses — a registry declaring what may
// be changed, overrides stored against it, and "empty means the shipped
// default". See src/app/modules/email/emailRegistry.ts, which explains the
// reasoning at length, and CONTENT-PLAN.md at the project root.
//
// What may be edited is decided by contentRegistry.ts, not by these tables. A
// key absent from the registry is not editable however it got here — that is
// what keeps the 1,664 admin and storefront-chrome strings out of reach while
// the 198 marketing ones are in it.
// ─────────────────────────────────────────────────────────────────────────────

/// One overridden string, in one language.
///
/// The key is the message catalogue's own dotted path — `home.hero.slides.0.title`
/// — rather than an id of our own. Reusing it means the merge is a lookup and
/// not a mapping table, and that a key renamed in the catalogue shows up as an
/// entry the registry no longer knows rather than as a silent mismatch.
model ContentEntry {
  /// Dotted path into the message catalogue.
  key String

  /// ISO 639-1 code. The set of valid values lives in src/config/locales.ts —
  /// the same rule the translation rows follow.
  ///
  /// Per locale, and deliberately so: 192 of the 198 editable strings say
  /// something different in German and English, because the English pages are
  /// their own translations rather than renderings of the German. One edit must
  /// never reach both.
  locale String

  value String

  /// Who last changed it. Six months from now somebody will ask.
  ///
  /// SetNull rather than Cascade, like every other authorship link here: losing
  /// the member of staff must not take the wording with it.
  updatedById String?
  updatedBy   User?   @relation("ContentEntryEditor", fields: [updatedById], references: [id], onDelete: SetNull)

  updatedAt DateTime @updatedAt

  @@id([key, locale])
  /// The read path asks for one language at a time and takes every override in
  /// it, which the primary key cannot answer from its second column alone.
  @@index([locale])
  @@map("content_entries")
}

/// One overridden picture.
///
/// No `locale`, and that is the point: the marketing images are shared by both
/// languages today, and the shop means one thing when it says "change this
/// picture". pageMedia.ts records where that was decided deliberately — the
/// English pages used to carry a stock photo and a leftover screenshot, and
/// both languages were pointed at the real product shots instead.
model ContentMedia {
  /// Dotted path, alongside the text keys — `home.hero.slides.0.image`.
  key String @id

  /// Null once the picture it named is deleted from the library, at which point
  /// the page falls back to the image shipped in pageMedia.ts. A gap somebody
  /// notices, rather than a broken link.
  assetId String?
  asset   Asset?  @relation("ContentImage", fields: [assetId], references: [id], onDelete: SetNull)

  updatedById String?
  updatedBy   User?   @relation("ContentMediaEditor", fields: [updatedById], references: [id], onDelete: SetNull)

  updatedAt DateTime @updatedAt

  @@map("content_media")
}

/// A long document with its own URL.
///
/// Holds Impressum, Datenschutz and AGB, which are ported from WordPress and
/// live in frontend/src/content/legal/ today. They are here rather than in
/// ContentEntry for the reason that loader already gives: the German privacy
/// policy alone runs to about ten thousand words, and it has no business in the
/// message bundle every page loads.
///
/// The same shape serves a page the shop writes itself later, which is why this
/// is `Page` and not `LegalDocument`.
model Page {
  /// URL segment, per locale — the German and English routes differ.
  slug   String
  locale String

  title    String
  /// Sanitised HTML, through the same allowlist the WordPress import used.
  /// Never rendered without it: this is injected into the page.
  bodyHtml String

  updatedById String?
  updatedBy   User?   @relation("PageEditor", fields: [updatedById], references: [id], onDelete: SetNull)

  updatedAt DateTime @updatedAt

  @@id([slug, locale])
  @@map("pages")
}
