// ─────────────────────────────────────────────────────────────────────────────
// The inquiry basket (Anfragekorb) and quote requests.
//
// This requirement was implemented FOUR times on the old shop — YITH, RFQ
// Toolkit, Addify, then WholesaleX plus custom code — and wreckage from all
// three dead attempts is still in that database. Every one of them bolted the
// idea onto the cart or onto a plugin's post type.
//
// Here it is a first-class entity with its own basket, its own submitted
// request, and its own conversation thread. Nothing about it borrows the cart's
// tables, because the two behave differently in ways that matter:
//
//   • a quote basket may contain products that have NO price at all
//   • guests may submit a quote, but may not check out (R7 vs R15)
//   • a quote is answered by a human and can expire
// ─────────────────────────────────────────────────────────────────────────────

enum QuoteStatus {
  /// Submitted, waiting on staff.
  OPEN
  /// Staff have replied, possibly with prices.
  ANSWERED
  /// Customer accepted the quoted prices.
  ACCEPTED
  /// Customer declined, or staff cannot supply.
  DECLINED
  /// Passed its expiry date without being accepted.
  EXPIRED
  /// Finished — converted to an order, or abandoned.
  CLOSED
}

enum QuoteAuthor {
  CUSTOMER
  STAFF
}

/// The working basket, before submission. Mirrors Cart's ownership model:
/// either a signed-in user or an anonymous token, merged on sign-in.
model QuoteBasket {
  id String @id @default(uuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  token String? @unique

  items QuoteBasketItem[]

  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@map("quote_baskets")
}

model QuoteBasketItem {
  id       String      @id @default(uuid())
  basketId String
  basket   QuoteBasket @relation(fields: [basketId], references: [id], onDelete: Cascade)

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  quantity Int

  /// What the customer wants for this specific line — engraving text, a
  /// material preference, a deadline.
  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([basketId, variantId])
  @@index([basketId])
  @@map("quote_basket_items")
}

/// A submitted request. Like an order, it freezes what was asked for.
model QuoteRequest {
  id     String @id @default(uuid())
  number Int    @unique @default(autoincrement())

  /// Null for a guest — guests may submit quotes even though they may not
  /// check out (R15). They are answered by email.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Contact details, captured for guests and copied for signed-in customers so
  /// the request stays readable if the account is later deleted.
  contactName    String
  contactEmail   String
  contactPhone   String?
  contactCompany String?

  /// Lets a guest follow their own request from an emailed link. Stored
  /// hashed — the raw value only ever exists in that email.
  accessTokenHash String? @unique

  title   String
  message String?

  status QuoteStatus @default(OPEN)
  locale String      @default("en")

  /// Quoted prices are an offer with a shelf life. The old shop had a cron job
  /// expiring these, which is how we know the field was real.
  expiresAt DateTime?

  /// Filled in once staff price the request.
  quotedSubtotal Decimal? @db.Decimal(12, 4)
  quotedCurrency String   @default("EUR")

  /// Set when the customer accepts and the request becomes a real order.
  convertedOrderId String?

  submittedAt DateTime  @default(now())
  answeredAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  items    QuoteRequestItem[]
  messages QuoteMessage[]

  @@index([userId])
  @@index([status])
  @@index([submittedAt])
  @@map("quote_requests")
}

model QuoteRequestItem {
  id      String       @id @default(uuid())
  quoteId String
  quote   QuoteRequest @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  /// Informational. SetNull so deleting a product never destroys the record of
  /// what was asked for.
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productId String?

  // Frozen at submission.
  sku        String
  name       String
  attributes String[] @default([])
  quantity   Int
  /// The minimum that applied when this was submitted, so a later change to
  /// the product does not make an old request look invalid.
  moqAtSubmission Int  @default(0)
  note            String?

  /// Staff fill these in when pricing the request. Null means unpriced.
  quotedUnitPrice Decimal? @db.Decimal(12, 4)
  quotedLineTotal Decimal? @db.Decimal(12, 4)

  @@index([quoteId])
  @@map("quote_request_items")
}

/// The conversation. Replaces the old shop's `wsx_conversation` post type.
model QuoteMessage {
  id      String       @id @default(uuid())
  quoteId String
  quote   QuoteRequest @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  author       QuoteAuthor
  authorUserId String?

  body String

  /// Staff-only note on the thread. Never returned to the customer.
  isInternal Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([quoteId])
  @@map("quote_messages")
}
