{
	"compilerOptions": {
		"target": "ES2023",
		"lib": ["ES2023"],
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"rootDir": "./src",
		"outDir": "./dist",
		"esModuleInterop": true,
		"jsx": "react-jsx",
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"sourceMap": true,
		"declaration": false
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist", "tests"]
}
